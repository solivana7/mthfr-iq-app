# Claude API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY=re_...

# Make.com webhook URL for the GHL push scenario
MAKE_WEBHOOK_URL=https://hook.us2.make.com/...

# GHL booking calendar link for Natasha
GHL_CALENDAR_LINK=https://api.leadconnectorhq.com/widget/bookings/YOUR_BOOKING_ID

# GHL API access — used by /api/check-foundation-access to detect Foundation members
# Same values as the foundation.solivana.ai Vercel project
GHL_API_KEY=
GHL_LOCATION_ID=

# Fullscript dispensary link (fallback if no per-protocol links are set)
FULLSCRIPT_LINK=https://us.fullscript.com/welcome/solivana

# Per-protocol Fullscript links (dynamic routing based on quiz results)
FULLSCRIPT_LINK_STARTER=https://us.fullscript.com/welcome/solivana
FULLSCRIPT_LINK_COMPLETE=https://us.fullscript.com/welcome/solivana
FULLSCRIPT_LINK_DETOX=https://us.fullscript.com/welcome/solivana

# Server config
PORT=8080
NODE_ENV=production
CLIENT_ORIGIN=*
